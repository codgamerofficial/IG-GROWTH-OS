# =============================================================================
# RIIQX — Master Environment Configuration Template
# Production Ready • Zero Firebase • Secure Social OAuth & AI Autopilot
# =============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase PostgreSQL, Auth & Storage
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Server-Side Token Encryption Vault (AES-256-GCM)
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=your-32-byte-hex-encryption-key-here

# -----------------------------------------------------------------------------
# Google & YouTube Data API v3 OAuth 2.0
# Register in Google Cloud Console > APIs & Services > Credentials
# Redirect URI: http://localhost:3000/api/social/oauth/callback/youtube
# Scopes: https://www.googleapis.com/auth/youtube.upload, https://www.googleapis.com/auth/youtube.readonly
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/social/oauth/callback/youtube

# -----------------------------------------------------------------------------
# Meta Graph API v20.0 (Instagram Reels & Facebook Pages)
# Register in Meta for Developers > App Dashboard > Facebook Login / Instagram Graph API
# Redirect URI: http://localhost:3000/api/social/oauth/callback/meta
# Scopes: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement, pages_manage_posts
# -----------------------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:3000/api/social/oauth/callback/meta
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id
INSTAGRAM_ACCESS_TOKEN=optional-direct-system-user-access-token

# -----------------------------------------------------------------------------
# WhatsApp Business Platform (Cloud API)
# -----------------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-cloud-api-token

# -----------------------------------------------------------------------------
# Autonomous Social Media Autopilot & Safe Boundaries
# -----------------------------------------------------------------------------
AUTONOMOUS_PUBLISHING=true
MOCK_MODE=false
NEXT_PUBLIC_MOCK_MODE=false

# -----------------------------------------------------------------------------
# AI Infrastructure & Model Providers
# -----------------------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-6

GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=qwen/qwen3.8-27b

OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

COHERE_API_KEY=your-cohere-api-key
COHERE_MODEL=command-r-plus-08-2024
