# =============================================================================
# NUVEXA AI — Master Environment Configuration Template
# One Assistant. Many Possibilities.
# Production Ready • Open-Source • Zero Firebase • Open-Weights First
# =============================================================================

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# AI Model Runtime Configuration (Open-Weight First)
# -----------------------------------------------------------------------------
# Local Ollama Gateway (Default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Self-Hosted / Cluster OpenAI-Compatible Endpoint (vLLM, LMStudio, LocalAI)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# -----------------------------------------------------------------------------
# Research & Web Retrieval (SearXNG Privacy Search)
# -----------------------------------------------------------------------------
SEARXNG_BASE_URL=https://searx.be

# -----------------------------------------------------------------------------
# PostgreSQL Database & Vector Storage (Optional Cloud / Docker)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://nuvexa:nuvexa2026@localhost:5432/nuvexa_db
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# Optional Extended Gateway Fallbacks
# -----------------------------------------------------------------------------
AGENTROUTER_API_KEY=your-agentrouter-api-key
AGENTROUTER_BASE_URL=https://api.agentrouter.ai/v1
AGENTROUTER_MODEL=deepseek/deepseek-v4-flash

AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-6
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Online AI Cloud Providers
GROQ_API_KEY=your-groq-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
NVIDIA_NIM_API_KEY=your-nvidia-nim-api-key
COHERE_API_KEY=your-cohere-api-key
