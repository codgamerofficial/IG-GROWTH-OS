# =============================================================================
# IG GrowthOS — Master Environment Configuration (Section 5)
# AI-Powered Instagram Command Center for RIIQX
# =============================================================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# -----------------------------------------------------------------------------
# Supabase (Database, Auth, Storage)
# Required for production persistence. In MOCK_MODE=true, in-memory repository is used.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# AWS Credentials & Region (Server-Side Only - NEVER exposed to browser)
# Required for Amazon Bedrock Runtime.
# In AWS production environments (ECS, Lambda, EC2), IAM roles are automatically used.
# -----------------------------------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# -----------------------------------------------------------------------------
# Amazon Bedrock AI Provider (Primary & Default)
# BEDROCK MUST BE THE DEFAULT AND PRIMARY PROVIDER.
# Model routing enables task-specific models with automatic fallback to BEDROCK_MODEL_ID.
# -----------------------------------------------------------------------------
AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-6

# Optional model routing overrides (falls back to BEDROCK_MODEL_ID if left empty):
CONTENT_MODEL_ID=
ANALYTICS_MODEL_ID=
TREND_MODEL_ID=
CHAT_MODEL_ID=

# Optional direct provider API keys (Bedrock is preferred):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Meta Developer / Instagram Graph API Configuration
# -----------------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/instagram/callback

# Optional direct long-lived token (not required if OAuth flow is used):
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# -----------------------------------------------------------------------------
# Application Behavior & Critical Safety Controls
# -----------------------------------------------------------------------------
# MOCK_MODE=true runs in safe simulation mode (simulated Meta publishing & Bedrock fallback)
# MOCK_MODE=false runs in live production with AWS Bedrock and Meta Graph APIs
MOCK_MODE=true
NEXT_PUBLIC_MOCK_MODE=true

# CRITICAL PUBLISHING SAFETY (Section 28)
# When false (default), publishing requires explicit approval_status === APPROVED.
# Unapproved content can NEVER publish unless AUTONOMOUS_PUBLISHING=true.
AUTONOMOUS_PUBLISHING=false
